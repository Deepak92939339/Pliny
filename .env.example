# Copy to .env.local for local development. Never commit real values.
# Full reference, defaults and clamps: docs/direct-upload-pipeline.md

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the scheduled maintenance job (src/app/api/cron/maintenance) and nothing else.
SUPABASE_SERVICE_ROLE_KEY=
# Vercel Cron sends this as `Authorization: Bearer $CRON_SECRET`. Without it the job answers 401.
CRON_SECRET=

# --- Upload and processing limits (defaults shown) ---------------------------
# Largest accepted file, bytes. Can be lowered, never raised past 15 MiB: the private bucket
# enforces file_size_limit = 15 MiB itself (supabase/migrations/20261015000000_*.sql).
# Read by both the browser pre-check and the server, so it is a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_UPLOAD_MAX_FILE_BYTES=15728640
# Signed upload URLs a user may request per hour (1-1000). Each retry costs one.
UPLOAD_MAX_REQUESTS_PER_HOUR=5
# /process calls per user per hour (1-1000). Includes Retry on a failed document.
PROCESS_MAX_REQUESTS_PER_HOUR=5
# Minutes a document may sit in one processing stage before it becomes "Needs attention"
# (6-240). The floor of 6 exists because the process function's maxDuration is 300 s.
PROCESSING_STALL_MINUTES=6
# Minutes an 'awaiting_upload' row may wait for its file before it is failed (5-110).
UPLOAD_EXPIRY_MINUTES=60

# --- Answer limits (defaults shown) -------------------------------------------
AI_ENABLED=false
AI_MAX_REQUESTS_PER_MINUTE=5
AI_MAX_REQUESTS_PER_DAY=30
AI_DAILY_BUDGET_INR=50
AI_MAX_OUTPUT_TOKENS=700
AI_MAX_CHUNKS=5
AI_MAX_CHARS_PER_CHUNK=3000
AI_MAX_CONTEXT_CHARS=12000

# --- Rate-limit store (required in production; routes fail closed without it) --
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
